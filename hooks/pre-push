#!/bin/bash
# pre-push hook: 拦截直接push到master的未复核commit
# 从被推送的commit中读取REVIEW_STAMP.md（而非工作区），防止自我批准
# 匹配锚定为表格行，防止违规记录中的hash被误判为批准

protected_branch="refs/heads/master"
zero="0000000000000000000000000000000000000000"

# 读取标准输入获取push信息
while read local_ref local_sha remote_ref remote_sha; do
    # 只检查push到master的情况
    if [ "$remote_ref" != "$protected_branch" ]; then
        continue
    fi

    echo "🔒 检测到push到master分支，正在校验复核凭证..."

    # 拦截删除master分支
    if [ "$local_sha" = "$zero" ]; then
        echo "🚫 拒绝删除受保护的master分支"
        exit 1
    fi

    # 拦截非快进推送（force-push回退）
    if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "🚫 拒绝非快进推送master（会丢失已批准的历史）"
        exit 1
    fi

    # 从被推送的commit中读取REVIEW_STAMP.md（而非工作区）
    stamp="$(git show "$local_sha:REVIEW_STAMP.md" 2>/dev/null)"
    if [ -z "$stamp" ]; then
        echo "🚫 被推送的commit中没有REVIEW_STAMP.md"
        exit 1
    fi

    # 获取待推送的commit列表
    if [ "$remote_sha" = "$zero" ]; then
        commits=$(git log --format="%h" "$local_sha" --not --remotes 2>/dev/null)
    else
        commits=$(git log --format="%h" "$remote_sha..$local_sha" 2>/dev/null)
    fi

    if [ -z "$commits" ]; then
        echo "✅ 没有新的commit需要推送"
        continue
    fi

    # 检查每个commit是否在REVIEW_STAMP.md的批准表格中（锚定匹配）
    all_approved=true
    for commit in $commits; do
        if ! echo "$stamp" | grep -qE "^\| *${commit} *\|.*✅" 2>/dev/null; then
            echo "❌ Commit $commit 未在REVIEW_STAMP.md中找到批准记录"
            all_approved=false
        fi
    done

    if [ "$all_approved" = false ]; then
        echo ""
        echo "🚫 Push被拒绝：存在未经过DeepSeek复核的commit"
        echo ""
        echo "正确流程："
        echo "  1. 创建新分支: git checkout -b fix/xxx"
        echo "  2. commit修改"
        echo "  3. push新分支: git push origin fix/xxx"
        echo "  4. 创建PR"
        echo "  5. DeepSeek复核通过后，在REVIEW_STAMP.md添加批准记录"
        echo "  6. 合并PR到master"
        echo ""
        echo "如需紧急hotfix（纯恢复/单行纯文本），请使用: git push --no-verify"
        exit 1
    fi

    echo "✅ 所有commit均已通过复核，允许push"
done

exit 0
