#!/bin/sh
# commit-msg 钩子（作品集机制迁移）：三闸门
#  闸门 1：message 必须含合法 ID 引用（GATE/PF-RV/RV/DEC/ISS）
#  闸门 2：命中评审红线 → 必须带已批准且 diff_hash 与当前 staged diff 完全一致的 PF-RV-ID
#  闸门 3：功能提交（feat/fix/refactor/perf 前缀）→ 必须引用 F-xxx 且存在已批准 scheme-RV
# 安装：git config core.hooksPath .githooks

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

# 闸门 1：ID 引用存在性
if ! printf '%s' "$MSG" | grep -Eq '\b(GATE|PF-RV|RV|DEC|ISS)[-:][0-9]{6,8}(-[0-9]+)?\b|\bISS-[0-9]+\b'; then
    echo "✗ commit-msg 钩子拒绝：message 必须含 ID 引用（GATE-* / PF-RV-* / DEC-* / ISS-*）" >&2
    exit 1
fi

# 闸门 2+3：调用 trace_gate.py
if [ -f tools/trace_gate.py ] && [ -f tools/gate_rules.yaml ]; then
    python3 tools/trace_gate.py check-rv --message "$MSG"
    RC=$?
    if [ $RC -ne 0 ]; then
        exit $RC
    fi
    python3 tools/trace_gate.py check-scheme --message "$MSG"
    RC=$?
    if [ $RC -ne 0 ]; then
        exit $RC
    fi
fi
exit 0
